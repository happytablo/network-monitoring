{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Monitoring": {
    "IntervalSeconds": 30,
    "PingTimeoutMilliseconds": 3000
  },
  "AllowedHosts": "*",
  "Jwt": {
    "SigningKey": "super-secret-key-for-that-api",
    "Issuer": "DeviceMonitoringApi",
    "Audience": "DeviceMonitoringClient",
    "ExpirationMinutes": 60
  }
}

